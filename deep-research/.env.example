# --- Gemini (Google AI Studio — clé gratuite : https://aistudio.google.com) ---
GEMINI_API_KEY=
# Modèle : gemini-2.5-flash (rapide) ou gemini-2.5-pro (plus fiable, quota plus serré)
GEMINI_MODEL=gemini-2.5-flash

# --- Source de recherche web ---
# duckduckgo (défaut) : recherche web GRATUITE via DuckDuckGo (pas de clé), le contexte
#   trouvé est injecté dans le prompt Gemini. Fonctionne sur le free tier Gemini.
# google  : Google Search grounding natif de Gemini — sources plus fiables, mais
#   presque toujours HORS free tier (facturation Google AI requise, ~35$/1000 requêtes).
# none    : aucune recherche, réponse du modèle seule (fallback de secours uniquement,
#   tout est marqué "à vérifier").
SEARCH_PROVIDER=duckduckgo
# Nombre de résultats DuckDuckGo consultés par hôtel
SEARCH_MAX_RESULTS=6
# Nombre de pages (parmi ces résultats) dont on récupère le texte complet
SEARCH_FETCH_PAGES=2

# --- Notion (https://notion.so/my-integrations) ---
NOTION_API_KEY=
# 32 caractères hex, dans l'URL de ta base entre le dernier "/" et le "?"
NOTION_DATABASE_ID=

# --- Cadence des appels Gemini (free tier = 15 req/min) ---
REQUEST_INTERVAL_MS=4500
MAX_RETRIES=4

# Seuil de confiance en dessous duquel un hôtel est marqué "à vérifier"
REVIEW_CONFIDENCE_THRESHOLD=0.6
