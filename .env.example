# Browser / Playwright
# true = no visible window (default). false = useful for debugging the selectors.
HEADLESS=true
# Locale and timezone sent to the browser (anti-bot consistency)
BROWSER_LOCALE=fr-FR
BROWSER_TIMEZONE=Africa/Douala

# Rate limiting (politeness / anti-ban)
# Max number of HTTP network requests per interval
RATE_MAX_REQUESTS=5
RATE_INTERVAL_MS=1000
# Concurrency of Playwright pages opened in parallel
BROWSER_CONCURRENCY=1

# Retry
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1500

# Proxies (optional)
# Comma-separated list. Accepted formats:
#   http://user:pass@host:port
#   http://host:port
#   host:port
PROXIES=

# Business defaults
DEFAULT_COUNTRY=CM

# Enrichment (--enrich option)
# SMTP probe (RCPT TO) to validate emails. Set to false if outbound port 25
# is blocked on your machine/server (emails then become "unknown").
SMTP_CHECK=true
SMTP_FROM=verify@example.com
# Max pages visited per site for the "website" enricher
WEBSITE_MAX_PAGES=4
# Leads enriched in parallel
ENRICH_CONCURRENCY=3
# Anthropic API key: enables review summary/sentiment ("reviews" enricher).
# Without a key: only raw review excerpts are returned.
ANTHROPIC_API_KEY=