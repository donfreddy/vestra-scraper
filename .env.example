# --- Navigateur / Playwright ---
# true = pas de fenêtre visible (défaut). false = utile pour déboguer les sélecteurs.
HEADLESS=true
# Locale et timezone envoyées au navigateur (cohérence anti-bot)
BROWSER_LOCALE=fr-FR
BROWSER_TIMEZONE=Africa/Douala

# --- Rate limiting (politesse / anti-ban) ---
# Nombre max de requêtes réseau HTTP par intervalle
RATE_MAX_REQUESTS=5
RATE_INTERVAL_MS=1000
# Concurrence des pages Playwright ouvertes en parallèle
BROWSER_CONCURRENCY=1

# --- Retry ---
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1500

# --- Proxies (optionnel) ---
# Liste séparée par des virgules. Formats acceptés :
#   http://user:pass@host:port
#   http://host:port
#   host:port
PROXIES=

# --- Défauts métier ---
DEFAULT_COUNTRY=CM

# --- Enrichissement (option --enrich) ---
# Sonde SMTP (RCPT TO) pour valider les e-mails. Mettre false si le port 25
# sortant est bloqué sur ta machine/serveur (les e-mails passent en "unknown").
SMTP_CHECK=true
SMTP_FROM=verify@example.com
# Pages max visitées par site pour l'enricher "website"
WEBSITE_MAX_PAGES=4
# Leads enrichis en parallèle
ENRICH_CONCURRENCY=3
# Clé API Anthropic — active le résumé/sentiment des avis (enricher "reviews").
# Sans clé : on remonte seulement des extraits d'avis bruts.
ANTHROPIC_API_KEY=
