{
  "name": "vestra",
  "version": "0.1.0",
  "description": "Vestra — extraction et enrichissement de leads B2B (Google Maps, annuaires) en Node.js/TypeScript, sans API tierce payante.",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "playwright install chromium || echo 'playwright: exécuter `yarn playwright install chromium` manuellement'",
    "link:local": "yarn build && npm link"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cheerio": "^1.0.0",
    "commander": "^15.0.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "got": "^14.4.2",
    "hpagent": "^1.2.0",
    "libphonenumber-js": "^1.11.9",
    "ora": "^9.4.1",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "playwright": "^1.47.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
